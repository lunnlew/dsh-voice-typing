{
  "name": "dsh-voice-typing",
  "version": "0.0.7",
  "description": "语音输入与对话朗读：点一下或按快捷键切换语音模式，边说边出字，离线本地识别（SenseVoice + Silero VAD），支持自定义词表、热词提示与多模型档位；回复可用 Edge 在线 / 本地神经模型 / 系统语音三种引擎朗读。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "voice",
    "typing",
    "dictation",
    "asr",
    "tts",
    "speech-to-text",
    "local-asr",
    "voice-mode",
    "语音",
    "语音输入",
    "语音模式"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "!lib/cuda-node"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "msedge-tts": "^2.1.1",
    "sherpa-onnx": "^1.13.6"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-llm": ">=0.2.1-rc.5",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-llm": {
      "optional": true
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.5",
    "node": ">=22"
  },
  "packageManager": "pnpm@11.7.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lunnlew/dsh-voice-typing.git"
  },
  "homepage": "https://github.com/lunnlew/dsh-voice-typing#readme",
  "bugs": {
    "url": "https://github.com/lunnlew/dsh-voice-typing/issues"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "eslint": "10.14.0",
    "react": "^18.2.0",
    "react-dom": "18.3.1"
  },
  "scripts": {
    "test": "node scripts/run-tests.mjs",
    "test:quiet": "node scripts/run-tests.mjs --quiet",
    "test:silence": "node test/silence.test.mjs",
    "lint": "eslint src test scripts",
    "build:client": "node scripts/build-client.mjs",
    "build:host": "node scripts/build-host.mjs",
    "build": "node scripts/build-client.mjs && node scripts/build-host.mjs",
    "check:client": "node scripts/build-client.mjs --check",
    "check:host": "node scripts/build-host.mjs --check",
    "check:build": "node scripts/build-client.mjs --check && node scripts/build-host.mjs --check",
    "prepack": "node scripts/build-client.mjs && node scripts/build-host.mjs"
  },
  "optionalDependencies": {
    "sherpa-onnx-node": "1.13.6",
    "uiohook-napi": "^1.5.5"
  }
}
